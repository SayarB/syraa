# Local Docker Postgres (see compose.yaml)
POSTGRES_USER=syraa
POSTGRES_PASSWORD=syraa
POSTGRES_DB=syraa
POSTGRES_PORT=5432
# Bind address for published DB/Redis ports (127.0.0.1 = not exposed on LAN/VPS)
# POSTGRES_HOST_BIND=127.0.0.1
# REDIS_HOST_BIND=127.0.0.1

# Host machine / local tests (postgres exposed on localhost)
DATABASE_URL=postgresql://syraa:syraa@localhost:5432/syraa

# Redis (ingest job queue — list BRPOP, see packages/ingest)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Local MVP drive (PDF blobs). Shared with ingest-worker via Docker volume `drive_data`.
# Host path when running api/worker on the host: relative to cwd (repo root).
DRIVE_ROOT=data/drive

# API
API_PORT=3000

# Better Auth (required for Docker/production sign-in)
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Browser origin — local Vite: http://localhost:5173 ; Docker UI: http://localhost:3000
# Production / Dokploy: https://your.domain (no trailing slash)
BETTER_AUTH_URL=http://localhost:5173
# Optional extra origins (comma-separated), e.g. a second domain
# BETTER_AUTH_TRUSTED_ORIGINS=
# Trust X-Forwarded-* from Dokploy/Traefik (default on when NODE_ENV=production)
# TRUST_PROXY=1

# Google OAuth (optional — shows "Continue with Google" when both are set)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Magic-link email via Resend (required in production for email sign-in)
# Without RESEND_API_KEY, links are logged to the API console (local only)
# RESEND_API_KEY=
# EMAIL_FROM=SYRAA <noreply@yourdomain.com>

# Local/tests only — used when BETTER_AUTH_SECRET is unset. Ignored when secret is set.
# AUTH_DEV_USER=dev-user

# Chat — Fireworks (default) or OpenAI
CHAT_PROVIDER=fireworks
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# OpenAI fallback (set CHAT_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Embeddings for ingest-worker (auto = Fireworks key, else OpenAI, else skip / null)
# EMBEDDING_PROVIDER=auto|fireworks|openai|hash|none
EMBEDDING_PROVIDER=auto
# EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# Vite web UI (optional direct API base; leave empty to use Vite /api proxy)
# VITE_API_BASE=
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# --- VPS / Dokploy (compose) ---
# Set strong POSTGRES_PASSWORD, BETTER_AUTH_SECRET, FIREWORKS_API_KEY (or OPENAI_*).
# BETTER_AUTH_URL must be the public HTTPS origin Dokploy assigns (same host as the UI).
# Point Dokploy at compose.yaml; publish only the api service (or let Dokploy proxy port 3000).
# Postgres/Redis stay on the compose network; host binds default to 127.0.0.1.
