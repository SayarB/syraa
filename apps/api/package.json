{
  "name": "@everyday/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Everyday API process — boots @everyday/harness HTTP (optional STATIC_DIR for baked UI)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "npm run build -w @everyday/harness && tsx src/index.ts"
  },
  "dependencies": {
    "@everyday/harness": "*",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
