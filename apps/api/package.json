{
  "name": "@syraa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Syraa API process — boots @syraa/harness HTTP (optional STATIC_DIR for baked UI)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "npm run build -w @syraa/harness && tsx src/index.ts"
  },
  "dependencies": {
    "@syraa/harness": "*",
    "dotenv": "^17.4.2",
    "undici": "^8.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
